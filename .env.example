# Run npm run setup:env, then fill in these hosted Supabase settings.
# Copy the Session pooler URI from your project's Connect dialog.
# Leave its password placeholder in place; put the actual password below.
DATABASE_URL=
DATABASE_PASSWORD=
# Download the server root certificate from Supabase Database settings.
DATABASE_CA_FILE=./supabase-ca.crt
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
APP_ORIGIN=http://127.0.0.1:5180
NODE_ENV=development
